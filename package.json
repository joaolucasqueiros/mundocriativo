{
  "name": "mundo-criativo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 5173 --bind 0.0.0.0 --directory public",
    "build": "node scripts/check-static.mjs",
    "preview": "python3 -m http.server 4173 --bind 0.0.0.0 --directory public",
    "deploy": "wrangler deploy",
    "deploy:delivery": "wrangler deploy --env delivery",
    "test": "playwright test",
    "test:delivery": "node --test worker/delivery.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.58.2",
    "wrangler": "4.65.0"
  }
}
