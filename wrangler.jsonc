{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mundocriativo",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-20",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/delivery/*"],
  },
  "services": [{ "binding": "JOTAFY", "service": "jotafy" }],
  // Activate after the private bucket and shared secret have been configured.
  "env": {
    "delivery": {
      "name": "mundocriativo",
      "services": [{ "binding": "JOTAFY", "service": "jotafy" }],
      "r2_buckets": [
        { "binding": "MATERIAL", "bucket_name": "mundo-criativo-materiais" },
      ],
    },
  },
}
